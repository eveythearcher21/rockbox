#! rockbox/tagbrowser/2.0
# SNARTY Y1 library. Custom menus are intentionally in a user override.
%format "artist_plays" "%010d %s" artistplays canonicalartist %sort = "inverse" %strip = "11"
%format "song" "%s" title
%format "fmt_title" "%s" title
%format "album_track" "%d.%02d. %s" discnum tracknum title ? discnum > "0"
%format "album_track" "%02d. %s" tracknum title ? tracknum > "0"
%format "album_track" "%s" title
%byfirstletter "artist_letters" "Artists by First Letter" "canonicalartist"
%byfirstletter "album_letters" "Albums by First Letter" "album"
%byfirstletter "song_letters" "Songs by First Letter" "title"

%menu_start "search_artists" "Search Artists"
"First Letter" ==> "artist_letters"
"Type a Name" -> canonicalartist ? canonicalartist ~ "" -> album -> title = "album_track"

%menu_start "search_albums" "Search Albums"
"First Letter" ==> "album_letters"
"Type a Name" -> album ? album ~ "" -> title = "album_track"

%menu_start "search_songs" "Search Songs"
"First Letter" ==> "song_letters"
"Type a Name" -> title = "song" ? title ~ ""

%menu_start "search" "Search"
"Artist" ==> "search_artists"
"Song Title" ==> "search_songs"
"Album" ==> "search_albums"

%menu_start "main" "Music"
"Songs" -> title = "song"
"Albums" -> album -> title = "album_track"
"Artists" -> canonicalartist -> album -> title = "album_track"
"Playlists" -> playlist_catalog
"Currently Playing" -> now_playing
"Genre" -> genre -> canonicalartist -> album -> title = "album_track"
"Year" -> year ? year > "0" -> canonicalartist -> album -> title = "album_track"
"Search" ==> "search"
"spotify wrapped" -> listening_wrapped

%menu_start "internal_shortcuts" "Shortcuts"
"Current Album" -> title = "album_track" ? album = "#album#"
"Most Listened to" -> canonicalartist = "artist_plays" -> album -> title = "album_track"
"Current Artist" -> album ? artist = "#artist#" | albumartist = "#artist#" -> title = "album_track"

%root_menu "main"
